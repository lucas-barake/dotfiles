{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/sse",
      "oauth": {}
    }
  },
  "permission": {
    "external_directory": {
      "~/*": "allow"
    },
    "bash": {
      "gh pr merge *": "ask",
      "gh release create *": "ask",
      "gh repo delete *": "ask",
      "pnpm publish *": "ask",
      "npm publish *": "ask",
      "rm -rf *": "ask"
    }
  }
}
