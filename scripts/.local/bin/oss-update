#!/bin/sh
set -e

OSS_DIR="$HOME/src/oss"

if [ ! -d "$OSS_DIR" ]; then
  echo "error: $OSS_DIR does not exist"
  exit 1
fi

for dir in "$OSS_DIR"/*/; do
  [ -d "$dir/.git" ] || continue
  name=$(basename "$dir")
  if git -C "$dir" pull --ff-only --quiet 2>/dev/null; then
    echo "ok $name"
  else
    echo "SKIP $name (not ff or no remote)"
  fi
done
