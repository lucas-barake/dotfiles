{
  // ─────────────────────────────────────────────────────────────
  // File Scanning & Search
  // ─────────────────────────────────────────────────────────────
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/node_modules",
    "**/.pnpm",
    "**/dist",
    "**/build",
    "**/.next",
    "**/.nuxt",
    "**/.turbo",
    "**/.cache",
    "**/.parcel-cache",
    "**/.venv",
    "**/venv",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/target",
    "**/.cargo",
    "**/vendor",
    "**/.bundle",
    "**/coverage",
    "**/.nyc_output",
    "**/*.log",
  ],

  // ─────────────────────────────────────────────────────────────
  // Theme & Appearance
  // ─────────────────────────────────────────────────────────────
  "vim_mode": true,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Dim Night",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Charmed Icons+",
    "dark": "Charmed Icons+",
  },
  "cursor_shape": "bar",
  "experimental.theme_overrides": {
    "players": [
      {
        "cursor": "#ffffff",
        "selection": "#214265",
      },
    ],
  },

  // ─────────────────────────────────────────────────────────────
  // Fonts
  // ─────────────────────────────────────────────────────────────
  "ui_font_family": "Monaspace Neon Var",
  "ui_font_size": 16,
  "buffer_font_family": "Monaspace Neon Var",
  "buffer_font_size": 18,
  "buffer_font_weight": 500.0,
  "buffer_line_height": { "custom": 1.45 },
  "agent_ui_font_size": 15,
  "agent_buffer_font_size": 15,

  // ─────────────────────────────────────────────────────────────
  // UI Panels & Layout
  // ─────────────────────────────────────────────────────────────
  "collaboration_panel": { "dock": "right" },
  "git_panel": { "dock": "right" },
  "project_panel": { "dock": "right" },
  "tab_bar": {
    "show": true,
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
  },
  "preview_tabs": { "enabled": false },
  "max_tabs": 7,
  "title_bar": { "show_branch_status_icon": true,
                 "show_branch_name": true },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
  },
  "show_call_status_icon": false,

  // ─────────────────────────────────────────────────────────────
  // Editor Behavior
  // ─────────────────────────────────────────────────────────────
  "semantic_tokens": "combined",
  "base_keymap": "VSCode",
  "soft_wrap": "editor_width",
  "show_whitespaces": "trailing",
  "format_on_save": "on",
  "vertical_scroll_margin": 5,
  "hover_popover_delay": 150,

  // ─────────────────────────────────────────────────────────────
  // Diagnostics & Inlay Hints
  // ─────────────────────────────────────────────────────────────
  "diagnostics_max_severity": null,
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": "warning",
      "padding": 4,
      "min_column": 0,
    },
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": false,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": null,
  },

  // ─────────────────────────────────────────────────────────────
  // AI & Edit Predictions
  // ─────────────────────────────────────────────────────────────
  "disable_ai": false,
  "show_edit_predictions": false,
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
    "enabled_in_text_threads": false,
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null,
    },
  },
  "agent": {
    "default_profile": "write",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5-thinking-latest",
    },
    "play_sound_when_agent_done": "always",
    "single_file_review": true,
  },

  // ─────────────────────────────────────────────────────────────
  // Terminal
  // ─────────────────────────────────────────────────────────────
  "terminal": {
    "button": false,
    "font_size": 18,
    "shell": { "program": "/opt/homebrew/bin/fish" },
  },

  // ─────────────────────────────────────────────────────────────
  // Languages
  // ─────────────────────────────────────────────────────────────
  "languages": {
    "TypeScript": {
      "language_servers": [
        "tsgo",
        "!vtsls",
        "oxc",
        "!typescript-language-server",
      ],
      "show_edit_predictions": true,
      "code_actions_on_format": { "source.fixAll.eslint": true },
      "colorize_brackets": true,
    },
    "TSX": {
      "language_servers": [
        "tsgo",
        "!vtsls",
        "oxc",
        "!typescript-language-server",
      ],
      "code_actions_on_format": { "source.fixAll.eslint": true },
      "colorize_brackets": true,
    },
    "JavaScript": {
      "language_servers": [
        "tsgo",
        "!vtsls",
        "oxc",
        "!typescript-language-server",
      ],
      "code_actions_on_format": { "source.fixAll.eslint": true },
      "colorize_brackets": true,
    },
    "JSON": { "colorize_brackets": true },
    "SQL": { "colorize_brackets": true },
  },

  // ─────────────────────────────────────────────────────────────
  // LSP Configuration
  // ─────────────────────────────────────────────────────────────
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true,
      },
    },
    "oxc": {
      "initialization_options": {
        "options": {
          "run": "onType",
          "typeAware": true,
        },
      },
    },
    // Kept for reference (currently disabled via language_servers)
    "vtsls": {
      "settings": {
        "vtsls": {
          "autoUseWorkspaceTsdk": true,
          "experimental": {
            "completion": {
              "enableServerSideFuzzyMatch": true,
              "entriesLimit": 10,
            },
          },
        },
        "typescript": {
          "preferGoToSourceDefinition": true,
          "tsserver": {
            "maxTsServerMemory": 24576,
            "enableTracing": false,
            "log": "off",
          },
          "inlayHints": {
            "parameterNames": {
              "enabled": "all",
              "suppressWhenArgumentMatchesName": true,
            },
          },
        },
        "javascript": {
          "preferGoToSourceDefinition": true,
          "tsserver": {
            "maxTsServerMemory": 8192,
            "enableTracing": false,
            "log": "off",
          },
          "inlayHints": {
            "parameterNames": {
              "enabled": "all",
              "suppressWhenArgumentMatchesName": true,
            },
          },
        },
      },
    },
  },

  "global_lsp_settings": {
    "semantic_token_rules": [
      { "token_type": "variable", "style": ["variable"] },
      { "token_type": "parameter", "style": ["variable.parameter"] },
      { "token_type": "property", "style": ["property"] },
      { "token_type": "namespace", "style": ["variable.namespace"] },
      { "token_type": "function", "style": ["function"] },
      { "token_type": "method", "style": ["function.method"] },
      { "token_type": "type", "style": ["type.class"] },
      { "token_type": "class", "style": ["type.class"] },
      { "token_type": "interface", "foreground_color": "#f8ca73" },
      { "token_type": "struct", "foreground_color": "#f8ca73" },
      { "token_type": "enum", "style": ["enum"] },
      { "token_type": "enumMember", "foreground_color": "#f8ca73" },
      { "token_type": "typeParameter", "style": ["type.parameter"] },
      { "token_type": "macro", "style": ["keyword"] },
      { "token_type": "keyword", "style": ["keyword"] },
      { "token_type": "comment", "style": ["comment"] },
      { "token_type": "string", "style": ["string"] },
      { "token_type": "number", "style": ["number"] },
      { "token_type": "operator", "style": ["operator"] },
    ],
  },

  // ─────────────────────────────────────────────────────────────
  // Profiles
  // ─────────────────────────────────────────────────────────────
  "profiles": {
    "rec": {
      "settings": {
        "ui_font_size": 24,
        "buffer_font_size": 24,
        "diagnostics": {
          "inline": {
            "enabled": true,
            "max_severity": "warning",
            "padding": 1,
            "min_column": 0
          }
        }
      }
    },
  },
}
